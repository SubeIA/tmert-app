/dist
/tmp
/out-tsc
/bazel-out
*.tgz

# Node
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Package managers (keep package-lock.json but ignore others)
yarn.lock
pnpm-lock.yaml
.yarn/
.pnp.*

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
